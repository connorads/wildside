amends "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Builtins.pkl"

exclude = List(".git", ".cache", "target")

display_skip_reasons = List()
terminal_progress = false

local binary_excludes = List(
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico",
    "*.woff", "*.woff2", "*.ttf", "*.eot", "*.pdf", "*.zip"
)

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
                exclude = binary_excludes
            }
            ["newlines"] = (Builtins.newlines) {
                exclude = binary_excludes
            }
            ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}
            // Workspace-wide (not just staged files) so rustfmt drift in
            // untouched files cannot accumulate. (#45)
            ["cargo-fmt"] {
                glob = List("crates/**/*.rs", "tests/**/*.rs")
                check = "cargo fmt --all -- --check"
                fix = "cargo fmt --all"
            }
            ["typos"] {
                exclude = binary_excludes + List("*.lock")
                fix = "typos --write-changes"
                check = "typos"
            }
            ["cargo-clippy"] {
                glob = List("crates/**/*.rs", "tests/**/*.rs", "Cargo.toml", "Cargo.lock")
                check = "scripts/quiet-on-success.sh cargo clippy --workspace --all-targets -- -D warnings"
            }
            ["cargo-deny"] {
                glob = List("**/Cargo.toml", "Cargo.lock", "deny.toml")
                check = "scripts/quiet-on-success.sh cargo deny check"
            }
            ["cargo-machete"] {
                glob = List("**/Cargo.toml", "Cargo.lock")
                check = "scripts/quiet-on-success.sh cargo machete"
            }
            ["backlog-lean"] {
                glob = List("docs/source-port/backlog.md")
                check = "python3 scripts/check_backlog_lean.py"
            }
            // #32 scoreboard: the dead-code marker count may only ever fall.
            // Own step (not in verify-slice-fast). check_first = false so the
            // fix always runs and a strip re-stages the lowered baseline; the
            // fix modifies a different file than its glob reads, so `stage`
            // names the baseline explicitly (Step.stage default is the glob).
            ["dead-code-ratchet"] {
                glob = List("crates/**/*.rs", "docs/source-port/dead-code-baseline.yaml")
                stage = List("docs/source-port/dead-code-baseline.yaml")
                check_first = false
                check = "python3 scripts/dead_code_ratchet.py"
                fix = "python3 scripts/dead_code_ratchet.py --update"
            }
            // #417: the ungated wildside-cli suite may only ever shrink its
            // failing-test set. Own step (not in verify-slice-fast). Mirrors
            // dead-code-ratchet: check_first = false so the fix always runs and
            // a fixed test re-stages the shrunk baseline; the fix modifies a
            // different file than its glob reads, so `stage` names it explicitly.
            ["failing-test-ratchet"] {
                glob = List("crates/**/*.rs", "docs/source-port/failing-test-baseline.yaml")
                stage = List("docs/source-port/failing-test-baseline.yaml")
                check_first = false
                check = "python3 scripts/failing_test_ratchet.py"
                fix = "python3 scripts/failing_test_ratchet.py --update"
            }
            ["verify-slice-fast"] {
                glob = List(
                    "crates/**/*.rs",
                    "tests/tas_frontier.json",
                    "Cargo.toml",
                    "Cargo.lock",
                    ".mise.toml",
                    "hk.pkl"
                )
                check = "scripts/quiet-on-success.sh mise run verify-slice-fast"
            }
        }
    }
}
